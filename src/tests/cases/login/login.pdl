module login

actor Member, Admin
const limit : 3..5 assuming lock_limit

Account : {Active, Locked} init Active cyclic
Account.Tries : 0..limit

Account.Fail @Member {
    Account = Active & Tries < limit => Tries' = Tries + 1
    Account = Active & Tries = limit => Account' = Locked
    else reject
}
Account.Success @Member {
    Account = Active => Tries' = 0
    else reject
}
Account.Unlock @Admin {
    Account = Locked => Account' = Active & Tries' = 0
    else reject
}

prop locked_only_at_limit: always Account = Locked => Tries = limit
prop never_stuck: always can Account = Active
run lock_after_four: Account = Active & limit = 3 -> Fail, Fail, Fail, Fail -> Account = Locked

unknown value lock_limit { label "잠금까지의 실패 횟수" source "보안 회의록 3행" provisional "5회" }

text {
    module "로그인 잠금"
    Member "회원"
    Admin "관리자"
    limit "잠금까지의 실패 횟수" why "보안팀이 3회에서 5회 사이로 정하기로 했다."
    Account "계정"
    Account.Active "사용 중"
    Account.Locked "잠김"
    Account.Tries "연속 실패 횟수"
    Account.Fail "로그인 실패"
    Account.Success "로그인 성공"
    Account.Unlock "잠금 해제"
    locked_only_at_limit why "잠금은 실패 횟수가 한도에 닿았을 때만 일어난다."
    never_stuck why "잠긴 계정은 언제든 다시 쓸 수 있게 된다."
}
